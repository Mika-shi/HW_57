@model HW_57.Models.ToDoTask

@{
    ViewData["Title"] = "Task details";
}

<h1>Task details</h1>

<div class="card mb-3" style="max-width: 800px;">
    <div class="card-body">
        <h3>@Model.Title</h3>

        <p>
            <strong>Description:</strong> @Model.Description
        </p>

        <p>
            <strong>Priority:</strong> @Model.Priority
        </p>

        <p>
            <strong>Status:</strong> @Model.State
        </p>

        <p>
            <strong>Created on:</strong> @Model.CreatedOn.ToString("dd.MM.yyyy HH:mm")
        </p>

        @if (Model.ClosedOn != null)
        {
            <p>
                <strong>Closed on:</strong> @Model.ClosedOn.Value.ToString("dd.MM.yyyy HH:mm")
            </p>
        }

        <p>
            <strong>Creator:</strong>
            @if (Model.Creator != null)
            {
                @(Model.Creator.UserName ?? Model.Creator.Email)
            }
            else
            {
                <span>Unknown</span>
            }
        </p>

        <p>
            <strong>Executor:</strong>
            @if (Model.Executor != null)
            {
                @(Model.Executor.UserName ?? Model.Executor.Email)
            }
            else
            {
                <span>Free</span>
            }
        </p>
        
        @{
            string? currentUserId = ViewBag.CurrentUserId as string;
            bool isAdmin = ViewBag.IsAdmin == true;
            bool isCreator = currentUserId != null && Model.CreatorId == currentUserId;
            bool isExecutor = currentUserId != null && Model.ExecutorId == currentUserId;
        }

        <a asp-action="Index" asp-controller="Todo" class="btn btn-secondary">
            Back to tasks
        </a>
        
        @if (User.Identity != null && User.Identity.IsAuthenticated)
        {
            if (isAdmin || isCreator)
            {
                <a asp-action="Edit"
                   asp-controller="Todo"
                   asp-route-id="@Model.Id"
                   class="btn btn-warning">
                    Edit
                </a>

                <a asp-action="Delete"
                   asp-controller="Todo"
                   asp-route-id="@Model.Id"
                   onclick="return confirm('Are you sure you want to delete this task?');"
                   class="btn btn-danger">
                    Delete
                </a>
            }

            if (Model.State == TaskState.New && Model.ExecutorId == null)
            {
                <a asp-action="Open"
                   asp-controller="Todo"
                   asp-route-id="@Model.Id"
                   class="btn btn-success">
                    Take task
                </a>
            }

            if (Model.State == TaskState.Open && (isAdmin || isExecutor))
            {
                <a asp-action="Close"
                   asp-controller="Todo"
                   asp-route-id="@Model.Id"
                   class="btn btn-primary">
                    Close task
                </a>
            }
        }
        
    </div>
</div>