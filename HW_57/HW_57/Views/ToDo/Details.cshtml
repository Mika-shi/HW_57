@model HW_57.Models.ToDoTask

@{
    ViewData["Title"] = "Create Task";
}

<h1>Create Task</h1>

<form asp-action="Create" asp-controller="Todo" method="post">
    <div class="form-group">
        <label asp-for="Title">Task title</label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Priority">Priority</label>
        <select asp-for="Priority" asp-items="ViewBag.Priorities" class="form-control">
            <option value="">Choose priority</option>
        </select>
        <span asp-validation-for="Priority" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Description">Detailed description</label>
        <textarea asp-for="Description" class="form-control"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="ResponsableName">Responsable name</label>
        <input asp-for="ResponsableName" class="form-control" />
        <span asp-validation-for="ResponsableName" class="text-danger"></span>
    </div>

    <br />

    <button type="submit" class="btn btn-primary">Create</button>
</form>

<br />

<a asp-action="Index" asp-controller="Todo">Back to tasks</a>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}