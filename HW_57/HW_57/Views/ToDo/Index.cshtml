@model HW_57.ViewModels.ToDoIndexViewModel
@using HW_57.Models.Enums

@{
    ViewData["Title"] = "To-Do List";

    bool isAuthenticated = User.Identity != null && User.Identity.IsAuthenticated;
    bool isAdmin = User.IsInRole("admin");
    string? currentUserId = ViewBag.CurrentUserId as string;
}

<h1>To-Do List</h1>

@if (isAuthenticated)
{
    <a asp-action="Create" asp-controller="Todo" class="btn btn-primary">
        Create new task
    </a>

    <br />
    <br />
}

@if (TempData["Message"] != null)
{
    <div class="alert alert-warning">
        @TempData["Message"]
    </div>
}

<form asp-action="Index" asp-controller="Todo" method="get" class="row g-3">
    <div class="col-md-4">
        <label>Title</label>
        <input type="text"
               name="title"
               value="@ViewBag.FilterTitle"
               placeholder="Enter the title of the task"
               class="form-control" />
    </div>

    <div class="col-md-4">
        <label>Created from</label>
        <input type="date"
               name="createdFrom"
               value="@ViewBag.CreatedFrom"
               class="form-control" />
    </div>

    <div class="col-md-4">
        <label>Created to</label>
        <input type="date"
               name="createdTo"
               value="@ViewBag.CreatedTo"
               class="form-control" />
    </div>

    <div class="col-md-4">
        <label>Description</label>
        <input type="text"
               name="descriptionWords"
               value="@ViewBag.DescriptionWords"
               placeholder="Enter words from description"
               class="form-control" />
    </div>

    <div class="col-md-4">
        <label>Priority</label>
        <select name="priority" asp-items="ViewBag.Priorities" class="form-control">
            <option value="">All priorities</option>
        </select>
    </div>

    <div class="col-md-4">
        <label>Status</label>
        <select name="state" asp-items="ViewBag.States" class="form-control">
            <option value="">All statuses</option>
        </select>
    </div>

    <div class="col-md-12">
        <button type="submit" class="btn btn-primary">
            Filter
        </button>

        <a asp-action="Index" asp-controller="Todo" class="btn btn-secondary">
            Reset
        </a>
    </div>
</form>

<br />

@if (Model.Tasks.Count == 0)
{
    <div class="alert alert-warning">
        No tasks found.
    </div>
}
else
{
    <table class="table table-striped">
        <thead>
        <tr>
            <th>
                <a asp-action="Index"
                   asp-route-sortOrder="@ViewBag.TitleSort"
                   asp-route-title="@ViewBag.FilterTitle"
                   asp-route-createdFrom="@ViewBag.CreatedFrom"
                   asp-route-createdTo="@ViewBag.CreatedTo"
                   asp-route-descriptionWords="@ViewBag.DescriptionWords"
                   asp-route-priority="@ViewBag.Priority"
                   asp-route-state="@ViewBag.State">
                    Title
                </a>
            </th>

            <th>
                <a asp-action="Index"
                   asp-route-sortOrder="@ViewBag.PrioritySort"
                   asp-route-title="@ViewBag.FilterTitle"
                   asp-route-createdFrom="@ViewBag.CreatedFrom"
                   asp-route-createdTo="@ViewBag.CreatedTo"
                   asp-route-descriptionWords="@ViewBag.DescriptionWords"
                   asp-route-priority="@ViewBag.Priority"
                   asp-route-state="@ViewBag.State">
                    Priority
                </a>
            </th>

            <th>
                <a asp-action="Index"
                   asp-route-sortOrder="@ViewBag.StateSort"
                   asp-route-title="@ViewBag.FilterTitle"
                   asp-route-createdFrom="@ViewBag.CreatedFrom"
                   asp-route-createdTo="@ViewBag.CreatedTo"
                   asp-route-descriptionWords="@ViewBag.DescriptionWords"
                   asp-route-priority="@ViewBag.Priority"
                   asp-route-state="@ViewBag.State">
                    Status
                </a>
            </th>

            <th>
                <a asp-action="Index"
                   asp-route-sortOrder="@ViewBag.CreatedOnSort"
                   asp-route-title="@ViewBag.FilterTitle"
                   asp-route-createdFrom="@ViewBag.CreatedFrom"
                   asp-route-createdTo="@ViewBag.CreatedTo"
                   asp-route-descriptionWords="@ViewBag.DescriptionWords"
                   asp-route-priority="@ViewBag.Priority"
                   asp-route-state="@ViewBag.State">
                    Created on
                </a>
            </th>

            <th>Creator</th>
            <th>Executor</th>

            @if (isAuthenticated)
            {
                <th>Actions</th>
            }
        </tr>
        </thead>

        <tbody>
        @foreach (var task in Model.Tasks)
        {
            bool isCreator = currentUserId != null && task.CreatorId == currentUserId;
            bool isExecutor = currentUserId != null && task.ExecutorId == currentUserId;

            <tr>
                <td>@task.Title</td>

                <td>@task.Priority</td>

                <td>@task.State</td>

                <td>@task.CreatedOn.ToString("dd.MM.yyyy HH:mm")</td>

                <td>
                    @if (task.Creator != null)
                    {
                        @(task.Creator.UserName ?? task.Creator.Email)
                    }
                    else
                    {
                        <span>Unknown</span>
                    }
                </td>

                <td>
                    @if (task.Executor != null)
                    {
                        @(task.Executor.UserName ?? task.Executor.Email)
                    }
                    else
                    {
                        <span>Free</span>
                    }
                </td>

                @if (isAuthenticated)
                {
                    <td>
                        <a asp-action="Details"
                           asp-controller="Todo"
                           asp-route-id="@task.Id"
                           class="btn btn-outline-primary btn-sm">
                            Details
                        </a>

                        @if (isAdmin)
                        {
                            <a asp-action="Edit"
                               asp-controller="Todo"
                               asp-route-id="@task.Id"
                               class="btn btn-warning btn-sm">
                                Edit
                            </a>

                            @if (task.State == TaskState.New)
                            {
                                <a asp-action="Open"
                                   asp-controller="Todo"
                                   asp-route-id="@task.Id"
                                   class="btn btn-success btn-sm">
                                    Take task
                                </a>
                            }

                            @if (task.State == TaskState.Closed)
                            {
                                <a asp-action="Open"
                                   asp-controller="Todo"
                                   asp-route-id="@task.Id"
                                   class="btn btn-success btn-sm">
                                    Reopen
                                </a>
                            }

                            @if (task.State != TaskState.Closed)
                            {
                                <a asp-action="Close"
                                   asp-controller="Todo"
                                   asp-route-id="@task.Id"
                                   class="btn btn-warning btn-sm">
                                    Close
                                </a>
                            }

                            <a asp-action="Delete"
                               asp-controller="Todo"
                               asp-route-id="@task.Id"
                               onclick="return confirm('Are you sure you want to delete this task?');"
                               class="btn btn-danger btn-sm">
                                Delete
                            </a>
                        }
                        else
                        {
                            @if (isCreator)
                            {
                                <a asp-action="Edit"
                                   asp-controller="Todo"
                                   asp-route-id="@task.Id"
                                   class="btn btn-warning btn-sm">
                                    Edit
                                </a>

                                <a asp-action="Delete"
                                   asp-controller="Todo"
                                   asp-route-id="@task.Id"
                                   onclick="return confirm('Are you sure you want to delete this task?');"
                                   class="btn btn-danger btn-sm">
                                    Delete
                                </a>
                            }

                            @if (task.State == TaskState.New && task.ExecutorId == null)
                            {
                                <a asp-action="Open"
                                   asp-controller="Todo"
                                   asp-route-id="@task.Id"
                                   class="btn btn-success btn-sm">
                                    Take task
                                </a>
                            }

                            @if (task.State == TaskState.Open && isExecutor)
                            {
                                <a asp-action="Close"
                                   asp-controller="Todo"
                                   asp-route-id="@task.Id"
                                   class="btn btn-warning btn-sm">
                                    Close
                                </a>
                            }

                            @if (task.State == TaskState.Closed)
                            {
                                <button class="btn btn-secondary btn-sm" disabled>
                                    Closed
                                </button>
                            }
                        }
                    </td>
                }
            </tr>
        }
        </tbody>
    </table>
}

<br />

@if (Model.Tasks.Count > 0)
{
    <div>
        @if (Model.PageViewModel.HasPreviousPage)
        {
            <a asp-action="Index"
               asp-route-page="@(Model.PageViewModel.PageNumber - 1)"
               asp-route-sortOrder="@ViewBag.SortOrder"
               asp-route-title="@ViewBag.FilterTitle"
               asp-route-createdFrom="@ViewBag.CreatedFrom"
               asp-route-createdTo="@ViewBag.CreatedTo"
               asp-route-descriptionWords="@ViewBag.DescriptionWords"
               asp-route-priority="@ViewBag.Priority"
               asp-route-state="@ViewBag.State"
               class="btn btn-outline-primary">
                Previous
            </a>
        }

        <span class="mx-2">
            Page @Model.PageViewModel.PageNumber of @Model.PageViewModel.TotalPages
        </span>

        @if (Model.PageViewModel.HasNextPage)
        {
            <a asp-action="Index"
               asp-route-page="@(Model.PageViewModel.PageNumber + 1)"
               asp-route-sortOrder="@ViewBag.SortOrder"
               asp-route-title="@ViewBag.FilterTitle"
               asp-route-createdFrom="@ViewBag.CreatedFrom"
               asp-route-createdTo="@ViewBag.CreatedTo"
               asp-route-descriptionWords="@ViewBag.DescriptionWords"
               asp-route-priority="@ViewBag.Priority"
               asp-route-state="@ViewBag.State"
               class="btn btn-outline-primary">
                Next
            </a>
        }
    </div>
}